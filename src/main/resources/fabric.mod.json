{
	"schemaVersion": 1,
	"id": "playermarket",
	"version": "${version}",
	"name": "Player Market",
	"description": "EVERYTHING HAS A PRICE. Your body, your assets, our market. Sell player stats for CR, trade resources, buy diamond augmentations, and build corporate archetypes.",
	"authors": [
		"Player Market Corp."
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/playermarket/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.playermarket.PlayerMarketMod"
		],
		"client": [
			"com.playermarket.client.PlayerMarketClient"
		]
	},
	"mixins": [
		"playermarket.mixins.json",
		{
			"config": "playermarket.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
